<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="cpf3HTML.xsl"?>
<certificationProblem
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xml/cpf3.xsd">
	<cpfVersion>3.0</cpfVersion>
	<lookupTables/>
	<input>
		<infeasibilityInput>
			<ctrs>
				<conditionType>
					<oriented/>
				</conditionType>
				<rules>
					<rule>
						<funapp>
							<name>a</name>
						</funapp>
						<funapp>
							<name>b</name>
						</funapp>
					</rule>
					<rule>
						<funapp>
							<name>f</name>
							<var>x</var>
						</funapp>
						<funapp><name>c</name></funapp>
						<conditions>
							<condition>
								<var>x</var>
								<funapp>
									<name>a</name>
								</funapp>
							</condition>
						</conditions>
					</rule>
				</rules>
			</ctrs>
            <infeasibilityQuery>
                <rule>
                <funapp>
                    <name>f</name>
                        <funapp>
                        <name>b</name>
                        </funapp>
                </funapp>
                <funapp>
                    <name>c</name>
                </funapp>
                </rule>
            </infeasibilityQuery>
		</infeasibilityInput>
	</input>
	<property>
		<infeasibility/>
	</property>
	<answer>
		<yes/>
	</answer>
	<proof>
        <infeasibilityProof>
            <leftInlineConditions>
				<rules>
					<rule>
						<funapp>
							<name>a</name>
						</funapp>
						<funapp>
							<name>b</name>
						</funapp>
					</rule>
					<rule>
						<funapp>
							<name>f</name>
							<funapp><name>a</name></funapp>
						</funapp>
						<funapp><name>c</name></funapp>
					</rule>
				</rules>
                <inlinedRules>
                    <inlinedRule>
                        <rule>
                            <funapp>
                                <name>f</name>
                                <var>x</var>
                            </funapp>
                            <funapp><name>c</name></funapp>
                            <conditions>
                                <condition>
                                    <var>x</var>
                                    <funapp>
                                        <name>a</name>
                                    </funapp>
                                </condition>
                            </conditions>
                        </rule>
                        <inlinedConditions>
                                <condition>
                                    <var>x</var>
                                    <funapp>
                                        <name>a</name>
                                    </funapp>
                                </condition>
                        </inlinedConditions>                 
                    </inlinedRule>
                </inlinedRules>
                <infeasibilityProof>
                    <infeasibleEquation>
                        <rule>
                        <funapp>
                            <name>f</name>
                                <funapp>
                                <name>b</name>
                                </funapp>
                        </funapp>
                        <funapp>
                            <name>c</name>
                        </funapp>
                        </rule>
                        <nonreachabilityProof>
                            <nonreachableTcap/>
                        </nonreachabilityProof>
                    </infeasibleEquation>
                </infeasibilityProof>    
            </leftInlineConditions>
        </infeasibilityProof>
	</proof>
	<metaInformation>
        <inputInfos>
            <inputInfo>COPS #807</inputInfo>
        </inputInfos>
        <toolInfos>
            <toolInfo>Example 3.33 in Florian Messner's master thesis</toolInfo>
        </toolInfos>
	</metaInformation>
</certificationProblem>
