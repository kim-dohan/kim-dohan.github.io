<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="cpf3HTML.xsl"?>
<certificationProblem xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../xml/cpf3.xsd">
    <cpfVersion>3.0</cpfVersion>
    
    <lookupTables>
        <ruleTable>
            <indexToRule>
                <index>1</index>
                <rule><funapp><name>a</name><funapp><name>a</name><var>x</var></funapp></funapp><funapp><name>a</name><funapp><name>b</name><funapp><name>a</name><var>x</var></funapp></funapp></funapp></rule>
            </indexToRule>
            <indexToRule>
                <index>2</index>
                <rule><funapp><name>b</name><var>x</var></funapp><funapp><name>b</name><funapp><name>b</name><var>x</var></funapp></funapp></rule>
            </indexToRule>
        </ruleTable>
    </lookupTables>    
    <input>        
        <trsInput>
            <trs>
                <rules>
                    <ruleIndex>1</ruleIndex>
                </rules>
            </trs>
            <relativeRules>
                <rules>
                    <ruleIndex>2</ruleIndex>
                </rules>
            </relativeRules>
        </trsInput>
    </input>
    <property>
        <termination/>
    </property>
    <answer>
        <yes/>
    </answer>
    <proof>
        <trsTerminationProof>
            <ruleRemoval>
                <interpretation>
                    <type>
                        <coreMatrixInterpretation>
                            <domain><integers/></domain>
                            <dimension>2</dimension>
                            <indices>
                                <nat>1</nat>
                            </indices>
                            <mode><E/></mode>
                        </coreMatrixInterpretation>
                    </type>
                    <interpret>
                        <name>a</name>
                        <arity>1</arity>
                        <product>
                            <matrix>
                                <vector><integer>1</integer><integer>1</integer></vector>
                                <vector><integer>1</integer><integer>0</integer></vector>
                            </matrix>
                            <variable>1</variable>
                        </product>
                    </interpret>
                    <interpret>
                        <name>b</name>
                        <arity>1</arity>
                        <product>
                            <matrix>
                                <vector><integer>1</integer><integer>0</integer></vector>
                                <vector><integer>0</integer><integer>0</integer></vector>
                            </matrix>
                            <variable>1</variable>
                        </product>
                    </interpret>
                </interpretation>
                <trs>
                    <rules>
                        <ruleIndex>1</ruleIndex>
                    </rules>
                </trs>                
                <trsTerminationProof><rIsEmpty/></trsTerminationProof>
            </ruleRemoval>
        </trsTerminationProof>
    </proof>
    <metaInformation>
        <inputInfos>
            <inputInfo>Example 2 in Hofbauer and Waldmann "Termination of String Rewriting with Matrix Interpretations"</inputInfo>
        </inputInfos>
    </metaInformation>
</certificationProblem>
