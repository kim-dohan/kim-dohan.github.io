<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="cpf3HTML.xsl"?><certificationProblem xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cpf3.xsd">
  <cpfVersion>3.0</cpfVersion>
  <lookupTables/>
  <input>
    <infeasibilityInput>
      <ctrs>
        <conditionType><oriented/></conditionType>
        <rules>
