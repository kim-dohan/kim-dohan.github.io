                    <degree>1</degree>
                    </polynomial>
                  </type>
                  <interpret>
                     <name>add</name>
                     <arity>2</arity>
                     <sum><variable>1</variable><variable>2</variable></sum>
                  </interpret>      
                  <interpret>
                     <name>s</name>
                     <arity>1</arity>
                     <sum><variable>1</variable><integer>-1</integer></sum>
                  </interpret>      
               </interpretation>
     </nonreachableCorewritePair>          
         </nonreachabilityProof>
